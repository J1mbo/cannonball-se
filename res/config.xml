<?xml version="1.0" encoding="utf-8"?>
<!-- Default config file for Cannonball-SE, a CannonBall fork by James Pearce. See https://github.com/J1mbo/cannonball -->
<!-- 
    Video Settings
-->
<video>
	<!-- Set Screen Mode:
         0 is windowed, 
         1 is full-screen
         2 is full-screen stretched, no borders. (Aspect ratio will be lost. Scanlines will be disabled.)
    Note: This build uses OpenGL-ES. Window mode may not be supported on all systems.
    -->
	<mode>1</mode>
	<!-- Window mode scale is the zoom factor for window mode, 1=original, 2=double etc -->
	<window>
		<scale>1</scale>
	</window>
	<!-- The following settings can be fully configured in-game -->
	<widescreen>0</widescreen>
	<fps_counter>0</fps_counter>
	<vsync>0</vsync>
	<x_offset>0</x_offset>
	<y_offset>0</y_offset>

	<!-- ==================================================================
         PERFORMANCE LEVERS
         These four settings dominate frame rate. If a board will not hold
         your target frame rate, change these first, in this order.
         See docs/PERFORMANCE-TUNING.md for the full board-by-board guide.
    -->
	<!-- Frame rate at startup: 0 = open at 30fps, 1 = open at 60fps.
         The game auto-switches upward if the hardware can sustain it, so 0 is
         a safe default. Use the -30 / -60 command-line flags to lock it. -->
	<fps>0</fps>
	<!-- Hi-resolution mode: 0 = original arcade resolution, 1 = double.
         COST: high (roughly quadruples the CPU pixel work). This is the single
         biggest lever on CPU-limited boards. -->
	<hires>1</hires>
	<!-- Hi-resolution sprites: 0 = exact ROM sprite sizes, 1 = sprites also
         rendered at hi-res. Only has an effect when hires is 1.
         COST: moderate, on the sprite renderer only. May cause slight
         misalignment of some objects. -->
	<hiresprites>0</hiresprites>
	<!-- CRT shader: 0 = off (pass-through), 1 = fast, 2 = full.
         COST: high, on the GPU. Measured on a Pi 2 (VideoCore IV at 500MHz,
         1280x1024): full 9.03 ms/frame, fast 7.23 ms/frame. Dropping from full
         to fast is the biggest lever on GPU-limited boards. -->
	<shader_mode>2</shader_mode>

	<!-- ==================================================================
         CRT LOOK
         These shape the picture. Apart from shadow_mask, none of them
         meaningfully affect frame rate.
    -->
	<!-- Shadow mask: 0 = off, 1 = overlay based (cheapest), 2 = shader based
         (looks better - can over-saturate bright pixels to white, which the
         overlay cannot). The shader mask pattern is baked into a texture at
         startup, so mode 2 is far cheaper than it used to be. -->
	<shadow_mask>2</shadow_mask>
	<!-- Shadow mask pitch in output pixels: 3 = normal. Use 4, 5 or 6 on
         high-DPI displays so the mask stays visible rather than aliasing away.
         Changing this re-bakes the mask texture; no video restart needed. -->
	<mask_size>3</mask_size>
	<!-- Mask dim / boost multipliers, as a percentage. maskDim darkens the
         masked-off pixels, maskBoost brightens the lit ones. -->
	<maskDim>75</maskDim>
	<maskBoost>125</maskBoost>
	<!-- Scanlines: 0 = off, 3 = maximum. -->
	<scanlines>0</scanlines>
	<!-- Screen curvature and bezel overlay: 0 = off, 1 = on. -->
	<crt_shape>1</crt_shape>
	<!-- Edge dimming, as a percentage (1 = 1%). -->
	<vignette>30</vignette>
	<!-- Analogue noise, as a percentage. This is per-pixel, per-frame work on
         the GPU - the only "CRT look" setting with a real cost. -->
	<noise>6</noise>
	<!-- Barrel distortion along each axis, as a percentage. The bezel overlay
         follows these automatically. -->
	<warpX>1</warpX>
	<warpY>3</warpY>
	<!-- Desaturation, as a percentage. desaturate raises the black level over
         the whole image; desaturate_edges adds more towards the edges. -->
	<desaturate>5</desaturate>
	<desaturate_edges>4</desaturate_edges>
	<!-- Output brightness, as a percentage. -->
	<brightboost>1</brightboost>

	<!-- ==================================================================
         NTSC (BLARGG) FILTER
         A CPU-side composite-video filter applied before the shader.
         See docs/SCREEN-FILTERS.md for what each mode looks like.
    -->
	<!-- 0 = off, 1 = composite, 2 = s-video, 3 = RGB.
         Composite adds the most artifacts (shimmer, dot crawl); RGB is the
         cleanest. COST: moderate, on the CPU, and the same for modes 1-3.
         Automatically disabled on single-core boards. -->
	<blargg>1</blargg>
	<!-- Filter tuning. None of these affect performance. -->
	<saturation>30</saturation>
	<contrast>0</contrast>
	<brightness>0</brightness>
	<!-- Edge blurring. -->
	<sharpness>0</sharpness>
	<!-- Horizontal resolution, -2 to 0. -->
	<resolution>0</resolution>
	<!-- Gamma, -3 to +3. -->
	<gamma>0</gamma>
	<!-- Hue, -10 to +10 (i.e. -0.1 to +0.1). -->
	<hue>-2</hue>
</video>
<!-- 
    Sound Settings
-->
<sound>
	<!-- Toggle Sound -->
	<enable>1</enable>
	<!-- Advertise Sound In Attract Mode -->
	<advertise>1</advertise>
	<!-- play music on music selection screen -->
	<preview>1</preview>
	<fix_samples>1</fix_samples>
	<!-- Countdown shown on the music/route select screen, in seconds.
	     0 = arcade default (30). Otherwise 1-99. -->
	<music_timer>0</music_timer>
	<!-- Sample Rate:
	     The arcade ran at 31,250Hz (or possibly 15,625Hz). This build supports that, except if using custom music via mp3,
	     then 22050 or 44100 must be used. -->
	<rate>44100</rate>
	<!-- A list of SDL audio devices will be shown on screen when cannonball is started. Devices often list more than one
         device, e.g. HDMI Audio and any USB sound device. Enter the number under playback_device corresponding to the device
         listed by the game. -->
	<playback_device>0</playback_device>
	<!-- Name of the SDL playback device, exactly as printed by -list-audio-devices. When set, this
	     takes priority over playback_device above, matched exactly then as a substring, so a device
	     keeps working even if its index changes between boots. Leave empty to use the index. Also
	     selectable live from the in-game SOUND menu (OUTPUT DEVICE). -->
	<playback_device_name></playback_device_name>
	<!-- Audio callback interval - 0 (8ms), 1 (16ms), or 2 (auto). 16ms doubles the audio
	     latency but may reduce dropouts on some systems. Auto selects 16ms on Raspberry
	     Pi 1/2/3-class CPUs (ARM1176/Cortex-A7/Cortex-A53) and 8ms elsewhere; also
	     selectable live from the in-game SOUND menu (AUDIO CALLBACK INTERVAL). -->
	<callback_rate>2</callback_rate>
	<!-- Real-time audio scheduling - 0 (off, default) or 1. When 1, the audio threads request SCHED_FIFO (needs an rtprio grant, see res/50-cannonball-audio.conf). Off by default: on some boards RT audio preempts the render threads and costs frame rate. Leave callback_rate on auto (2), or set 1 (16ms), to avoid dropouts instead. -->
	<rt_priority>0</rt_priority>
	<!-- Custom Music: Put .WAV, .MP3, or .YM files in res/ folder named as:
         [01–99]_Track_Display_Name.[wav|mp3|ym] - e.g. 04_AHA_Take_On_Me.mp3
         Indexes 01–03 will replace the built‑in tracks (01=Magical Sound Shower), higher indexes add tracks. -->
	<wave_volume>4</wave_volume>
</sound>
<!-- 
    Controls Settings
-->
<controls>
	<!-- Gears: 
        0 = Manual   (Click to shift, for normal play)
        1 = Manual   (Hold to shift, for cabinet play)
        2 = Automatic 
    -->
	<gear>2</gear>
	<!-- Which attached controller to use, when more than one is present.
	     0 = the first one SDL enumerates. -->
	<pad_id>0</pad_id>
	<!-- Keyboard Button Configuration. Easiest to configure with inbuilt menu. -->
	<keyconfig>
		<up>1073741906</up>
		<down>1073741905</down>
		<left>1073741904</left>
		<right>1073741903</right>
		<acc>97</acc>
		<brake>122</brake>
		<start>115</start>
		<coin>99</coin>
		<menu>109</menu>
		<gear1>103</gear1>
		<gear2>104</gear2>
		<view>118</view>
	</keyconfig>
	<!-- Gamepad / Joystick Button Configuration. Easiest to configure with inbuilt menu. -->
	<padconfig>
		<acc>1</acc>
		<brake>0</brake>
		<start>6</start>
		<coin>4</coin>
		<menu>5</menu>
		<gear1>9</gear1>
		<gear2>10</gear2>
		<view>3</view>
		<up>11</up>
		<down>12</down>
		<left>13</left>
		<right>14</right>
	</padconfig>
	<!-- Digital Controls: Steering Adjust Speed (1 to 9) -->
	<steerspeed>3</steerspeed>
	<!-- Digital Controls: Pedal Adjust Speed (1 to 9) -->
	<pedalspeed>4</pedalspeed>
	<!-- Analog Controls
         0 = Off
         1 = On
         2 = Wheel Only
    -->
	<analog enabled="1">
		<!-- Select axis for analog controls 
             You can place the accelerator and the brake on the same axis if your controller
             has a split axis setup. This is best avoided though.
          -->
		<axis>
			<wheel>0</wheel>
			<accel invert="1">2</accel>
			<brake invert="1">1</brake>
		</axis>
		<!-- Analog Wheel Settings -->
		<wheel>
			<!-- Amount of wheel turning circle to use.
                 Example:  0 means use the entire wheel (this works best if haptic is enabled)
                 larger values mean to progressively use less of the wheel turning circle -->
			<zone>0</zone>
			<!-- Dead Zone In Centre Of Wheel. Total Wheel Range = 128
                 A Dead zone is useful if the centre accuracy of your wheel is poor.
                 A good Logitech Racing wheel should not need this -->
			<dead>0</dead>
		</wheel>
		<!-- Force Feedback / Haptic Support -->
		<haptic enabled="1">
			<!-- Make both of the below values negative, 
                 if force feedback is in the wrong direction -->
			<!-- Maximum Force To Apply (0 to 10000) -->
			<max_force>8500</max_force>
			<!-- Minimum Force To Apply (0 to max_force) -->
			<min_force>7000</min_force>
			<!-- Length of each effect. (1/x seconds) 1/20th suggested. -->
			<force_duration>20</force_duration>
		</haptic>
	</analog>
	<rumble>1.25</rumble>

	<!-- ==================================================================
	     INPUT BINDING MATRIX (documentation only - not used by this build)
	     Data model and config load/save exist, but nothing below is read at
	     runtime yet. Leave this whole block
	     commented out to keep using pad_id/keyconfig/padconfig/analog above
	     exactly as configured.

	<input_mode>0</input_mode>
	     0 = GAMEPAD, 1 = WHEEL. If absent, GAMEPAD is assumed once a
	     <bindings> block below is present; otherwise unused.

	<bindings>
	     If this element is absent (as shipped), the legacy pad_id/keyconfig/
	     padconfig/analog settings above remain authoritative. One binding
	     per (group, target) cell; a target with no entry is simply unbound.
	     type is axis|button|hat; value is only used for hat (SDL_HAT_* mask).
	     device is a reconnect-safe signature (GUID + axis/button/hat counts),
	     not a raw SDL joystick index, so it survives being re-plugged into a
	     different USB port or enumerated in a different order.
	    <gamepad>
	        <steer type="axis"   index="0" device="030000005e0400008e02000014010000|A6|B11|H1"
	               vid="045e" pid="028e" name="Xbox 360 Controller"/>
	        <accel type="axis"   index="5" device="030000005e0400008e02000014010000|A6|B11|H1"
	               vid="045e" pid="028e" name="Xbox 360 Controller"/>
	        <brake type="axis"   index="4" device="030000005e0400008e02000014010000|A6|B11|H1"
	               vid="045e" pid="028e" name="Xbox 360 Controller"/>
	        <gear1 type="button" index="0" device="030000005e0400008e02000014010000|A6|B11|H1"
	               vid="045e" pid="028e" name="Xbox 360 Controller"/>
	    </gamepad>
	    <wheel>
	        <steer type="axis" index="0" device="0300000066f00000b6660000101f0000|A5|B13|H1"
	               vid="044f" pid="b66d" name="T150 Racing Wheel"/>
	        <accel type="axis" index="2" device="03000000d90200000001000000000000|A3|B0|H0"
	               vid="1dd2" pid="0001" name="Sim Pedals"/>
	        <start type="hat"  index="0" value="1" device="0300000066f00000b6660000101f0000|A5|B13|H1"
	               vid="044f" pid="b66d" name="T150 Racing Wheel"/>
	    </wheel>
	</bindings>
	-->
</controls>
<!-- 
    Game Engine Settings
-->
<engine>
	<!-- Game Time: 
         0 = Easy      (80 seconds)
         1 = Normal    (75 seconds) 
         2 = Hard      (72 seconds) 
         3 = Very Hard (70 seconds)  
         4 = Infinite Time 
    -->
	<time>0</time>
	<!-- Traffic Difficulty: 
         0 = Easy, 
         1 = Normal, 
         2 = Hard, 
         3 = Very Hard 
         4 = No Traffic
    -->
	<traffic>1</traffic>
	<!-- The original Japanese release of OutRun featured slightly different
         tracks and course ordering. 
         
         Requires additional ROM files:
         epr-10380.133, epr-10382.118, epr-10381.132, epr-10383.117
         epr-10327.76,  epr-10329.58,  epr-10328.75,  epr-10330.57
    -->
	<japanese_tracks>0</japanese_tracks>
	<!-- Swap In Prototype Coconut Beach Track -->
	<prototype>0</prototype>
	<!-- Increase the number of allowed level objects. 
         This fixes the broken arches in Gateway for example.
    -->
	<levelobjects>1</levelobjects>
	<!-- Use the original random number generator seed to match the setup of
         the original game. Disable to use a truly random setup.
         This will affect initial traffic patterns in attract mode for example.
    -->
	<randomgen>1</randomgen>
	<!-- Fix minor bugs present in the original engine. -->
	<!-- Tile on music select screen, ms value at checkpoint etc. -->
	<fix_bugs>1</fix_bugs>
	<fix_timer>1</fix_timer>
	<!-- Fix the unpredictable brake-check: a newly spawned traffic car could
	     inherit a stale "car ahead" speed from the previous use of its sprite
	     slot, and so slow sharply when the player pulled alongside it with
	     nothing actually in front. 0 = original arcade behaviour. -->
	<fix_traffic>0</fix_traffic>
	<new_attract>0</new_attract>
	<freeplay>1</freeplay>
	<offroad>0</offroad>
	<grippy_tyres>0</grippy_tyres>
	<bumper>0</bumper>
	<turbo>0</turbo>
	<car_color>0</car_color>
</engine>
<!-- Settings for Time Trial Mode -->
<time_trial>
	<!-- Default Number of Laps (1 - 5) -->
	<laps>3</laps>
	<!-- Default Amount of Traffic (0 - 8), where 0 is off -->
	<traffic>3</traffic>
</time_trial>
<!-- 
    Use the inbuilt menu system. 
    You can disable it and edit this config file instead if it makes more sense for your system.
 -->
<menu>
	<enabled>0</enabled>
	<roadspeed>25</roadspeed>
</menu>
<continuous>
	<traffic>1</traffic>
</continuous>
