# Every ignore rule for this repository lives in this file. Please do not add
# nested .gitignore files: patterns containing a slash are anchored to the
# directory holding the .gitignore, which has already caused one set of rules
# here to silently match nothing.

# ---------------------------------------------------------------------------
# Local build output
# ---------------------------------------------------------------------------
build/
build-*/
dist-win/

# ---------------------------------------------------------------------------
# SEGA OutRun ROM binaries are copyrighted and must NEVER be committed.
# Ignore everything under roms/ except the placeholder text file(s).
# ---------------------------------------------------------------------------
/roms/*
!/roms/roms.txt
!/roms/README.txt
!/roms/.gitkeep

# ---------------------------------------------------------------------------
# Working research, designs and measurements (local only)
# ---------------------------------------------------------------------------
working-docs/
docs/working/

# ---------------------------------------------------------------------------
# tools/ntsc_bench
#
# stage/  is per-revision build staging, regenerated by run_host.sh/run_pi.sh.
# frames/ is the captured benchmark corpus: rendered OutRun graphics, and so
#         SEGA's copyright exactly as the ROMs are. It is never committed -
#         regenerate it with tools/ntsc_bench/capture_frames.sh. Only the
#         metadata needed to rebuild and verify it is tracked.
# ---------------------------------------------------------------------------
/tools/ntsc_bench/stage/
/tools/ntsc_bench/frames/*
!/tools/ntsc_bench/frames/manifest.txt
!/tools/ntsc_bench/frames/frames.sha256

# ---------------------------------------------------------------------------
# Test harnesses: build directories and compiled test binaries
# ---------------------------------------------------------------------------
/tools/road_tiles/test/b/
/tools/road_tiles/test/*_test
/tools/road_tiles/test/*_test_scalar
/tools/sprite_bench/test/build/
/tools/sprite_bench/test/*_test
/tools/sprite_bench/test/*_test_scalar
